{
  "description": "Capture assignment prompt and final response turns.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\capture-agent-turn.ps1",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .codex\\hooks\\capture-agent-turn.ps1",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
